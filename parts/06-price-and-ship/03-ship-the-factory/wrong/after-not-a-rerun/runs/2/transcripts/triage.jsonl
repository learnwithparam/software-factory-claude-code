 shares = splitCharge(charge.amount_cents, borrowers.length);\n  for (let i = 0; i < borrowers.length; i++) {\n    console.log(`${borrowers[i]}  ${money(shares[i])}`);\n  }\n  const total = shares.reduce((sum, share) => sum + share, 0);\n  console.log(`desk: charge ${money(charge.amount_cents)}, shares add up to ${money(total)}`);\n}\n\nif (command === \"overdue\") {\n  showOverdueLoans();\n} else if (command === \"search\") {\n  showMembersNamed(args.join(\" \"));\n} else if (command === \"lend\") {\n  lend(args[0], args[1]);\n} else if (command === \"split\") {\n  showSplit(args[0]);\n} else {\n  console.log(\"desk: commands are overdue, search <name>, lend <item> <member>, split <charge-id>\");\n}","numLines":30,"startLine":60,"totalLines":90}},"tool_result_meta":[{"id":"toolu_01AsED9UBgdDoNAizmiDtfmb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
