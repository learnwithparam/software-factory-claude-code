# The library's build server runs the factory with these settings. Nothing secret goes here.
# The token, CLAUDE_CODE_OAUTH_TOKEN, comes from the build server's secret store as an environment
# variable. On your own machine it lives in the git-ignored .env next to package.json.
FACTORY_CAP_USD=10
# Telemetry: Claude Code reports its own cost and token counts. On the build server they go to the
# console log, so the cost per issue can be checked against the runs. Never put a header token here.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=console
OTEL_METRIC_EXPORT_INTERVAL=5000
