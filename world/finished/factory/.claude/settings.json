{
  "permissions": {
    "allow": ["Bash(bun test *)", "Bash(bun run gate)", "Bash(git diff *)", "Bash(git status)", "Bash(git log *)"],
    "deny": [
      "Edit(src/auth/**)",
      "Write(src/auth/**)",
      "Bash(git push *)",
      "Bash(git push --force*)",
      "Bash(git commit --no-verify*)",
      "Bash(* --no-verify*)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lock-tests.ts" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bun \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.ts" }]
      }
    ]
  }
}
