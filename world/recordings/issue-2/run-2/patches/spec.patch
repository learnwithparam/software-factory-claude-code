@@ -9,6 +9,24 @@ test("one borrower pays the whole charge", () => {
   expect(splitCharge(3333, 1)).toEqual([3333]);
 });
 
+test("shares add up to the charge exactly", () => {
+  for (const [total, ways] of [[3333, 2], [1000, 3], [1, 7], [9999, 4], [0, 3]]) {
+    const shares = splitCharge(total, ways);
+    expect(shares).toHaveLength(ways);
+    expect(shares.reduce((a, b) => a + b, 0)).toBe(total);
+  }
+});
+
+test("the leftover cents go one each to the first borrowers", () => {
+  expect(splitCharge(3333, 2)).toEqual([1667, 1666]);
+  expect(splitCharge(1000, 3)).toEqual([334, 333, 333]);
+  expect(splitCharge(1001, 3)).toEqual([334, 334, 333]);
+});
+
+test("a charge smaller than the number of borrowers bills one cent to the first ones", () => {
+  expect(splitCharge(2, 3)).toEqual([1, 1, 0]);
+});
+
 test("a negative charge is refused", () => {
   expect(() => splitCharge(-1, 2)).toThrow();
 });
